{
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm install",
    "framework": "nextjs",
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "mutanttechnologies.com"
                }
            ],
            "destination": "https://www.mutanttechnologies.com/:path*",
            "permanent": true
        }
    ]
}